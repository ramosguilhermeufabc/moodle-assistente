{{!
    @template local_assistente/table

    Native table of the rows of a query. Every text is escaped; the texts generated by the LLM are data, never HTML.

    Example context (json):
    {
        "title": "Grades",
        "columns": [{"label": "Name"}, {"label": "Course total"}],
        "rows": [{"cells": [{"rowheader": true, "lines": [{"text": "Ana"}]}, {"rowheader": false, "lines": [{"text": "66,66%"}]}]}]
    }
}}
<table class="generaltable table-sm">
    <caption class="sr-only">{{title}}</caption>
    <thead>
        <tr>
            {{#columns}}<th scope="col">{{label}}</th>{{/columns}}
        </tr>
    </thead>
    <tbody>
        {{#rows}}
        <tr>
            {{#cells}}
            {{#rowheader}}<th scope="row">{{#lines}}<div>{{text}}</div>{{/lines}}</th>{{/rowheader}}
            {{^rowheader}}<td>{{#lines}}<div>{{text}}</div>{{/lines}}</td>{{/rowheader}}
            {{/cells}}
        </tr>
        {{/rows}}
    </tbody>
</table>
