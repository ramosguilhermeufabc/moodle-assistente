{{!
    @template local_assistente/report

    The current version of the report, with a link to the history, and one table for each block.

    Example context (json):
    {
        "available": true,
        "message": null,
        "hasreport": true,
        "noreport": false,
        "noresults": false,
        "versiontext": "Current version: 3",
        "generated": "28/10/26, 18:00",
        "historyurl": "https://example.com/local/assistente/index.php?id=2&tab=history",
        "blocks": [{"title": "Grades", "statetext": null, "hasrows": true, "columns": [{"label": "Name"}],
            "rows": [{"cells": [{"rowheader": true, "lines": [{"text": "Ana"}]}]}]}]
    }
}}
<div class="local-assistente-report">
    {{^available}}<div class="alert alert-info" role="status">{{message}}</div>{{/available}}
    {{#noreport}}<p>{{#str}} report:none, local_assistente {{/str}}</p>{{/noreport}}
    {{#noresults}}<p>{{#str}} filter:no_results, local_assistente {{/str}}</p>{{/noresults}}
    {{#hasreport}}
        <p>
            <strong>{{versiontext}}</strong> ({{generated}}) &middot;
            <a href="{{historyurl}}">{{#str}} report:history_link, local_assistente {{/str}}</a>
        </p>
        {{#blocks}}
            <h3>{{title}}</h3>
            {{#statetext}}<p>{{statetext}}</p>{{/statetext}}
            {{#hasrows}}{{> local_assistente/table}}{{/hasrows}}
        {{/blocks}}
    {{/hasreport}}
</div>
