{{!
    @template local_assistente/history

    The history of an entity or of the report: one row for each version.

    Example context (json):
    {
        "title": "History",
        "available": true,
        "message": null,
        "norows": false,
        "noresults": false,
        "hasrows": true,
        "columns": [{"label": "Version"}],
        "rows": [{"cells": [{"rowheader": true, "lines": [{"text": "2"}]}]}]
    }
}}
<div class="local-assistente-history">
    <h3>{{title}}</h3>
    {{^available}}<div class="alert alert-info" role="status">{{message}}</div>{{/available}}
    {{#available}}
        {{#hasrows}}{{> local_assistente/table}}{{/hasrows}}
        {{#norows}}<p>{{#str}} query:no_data, local_assistente {{/str}}</p>{{/norows}}
        {{#noresults}}<p>{{#str}} filter:no_results, local_assistente {{/str}}</p>{{/noresults}}
    {{/available}}
</div>
